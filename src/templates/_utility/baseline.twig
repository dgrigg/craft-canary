{% if baseline %}
    <p class="light">
        Baseline #{{ baseline.id }}: {{ baseline.fileCount|number }} files, generated {{ baseline.generatedAt|datetime('short') }}.
        {{ baseline.summary }}.
    </p>
{% else %}
    <p class="warning has-icon">
        <span class="icon" aria-hidden="true"></span>
        No baseline yet. Rebuild it below, or run <code>php craft site-canary/scan --baseline</code>, after a clean deployment.
    </p>
{% endif %}
