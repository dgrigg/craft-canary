{
  "name": "dgrigg/craft-canary",
  "description": "Daily file integrity and server health checks for Craft CMS, with an emailed report.",
  "keywords": [
    "craft",
    "cms",
    "craftcms",
    "craft plugin",
    "security",
    "file integrity",
    "malware",
    "monitoring"
  ],
  "authors": [
    {
      "name": "Derrick Grigg",
      "email": "derrick@dgrigg.com"
    }
  ],
  "support": {
    "docs": "https://github.com/dgrigg/craft-canary/blob/main/README.md",
    "issues": "https://github.com/dgrigg/craft-canary/issues"
  },
  "license": "proprietary",
  "type": "craft-plugin",
  "require": {
    "php": "^8.2",
    "craftcms/cms": "^5.0.0"
  },
  "autoload": {
    "psr-4": {
      "dgrigg\\canary\\": "src/"
    }
  },
  "extra": {
    "name": "Site Canary",
    "handle": "site-canary",
    "developer": "DGrigg Dev Inc.",
    "developerUrl": "https://dgrigg.com",
    "documentationUrl": "https://github.com/dgrigg/craft-canary/blob/main/README.md",
    "class": "dgrigg\\canary\\Canary",
    "hasCpSettings": true,
    "hasCpSection": false,
    "changelogUrl": "https://raw.githubusercontent.com/dgrigg/craft-canary/main/CHANGELOG.md"
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  }
}
